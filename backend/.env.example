# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Domínio da API (aponte o DNS para o IP do VPS)
API_DOMAIN=api.nesaro.com.br

# Meta for Developers → seu app → Instagram → API setup with Instagram login
Meta__AppId=
Meta__AppSecret=
Meta__RedirectUri=https://api.nesaro.com.br/auth/instagram/callback
# Uma senha que você inventa e cadastra também no painel de Webhooks da Meta
Meta__WebhookVerifyToken=
Meta__GraphVersion=v23.0
Meta__AppReturnUrl=

# Firebase (mesmo projeto do app)
Firebase__ProjectId=
